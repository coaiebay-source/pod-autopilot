# OpenBot deployment configuration for POD Autopilot.
#
# Copy to .env, fill in, and never commit the filled version.
#
# ---------------------------------------------------------------------------
# OPENBOT PLATFORM
# ---------------------------------------------------------------------------
# Admits every request as one administrator. REQUIRED when no identity provider
# is configured. This means: DO NOT EXPOSE THIS PORT TO THE INTERNET. Keep it
# on localhost / a VPN / a Tailscale tailnet. OpenBot is alpha software with a
# documented no-auth default and open authorization issues.
OPENBOT_SINGLE_USER=true
NODE_ENV=production

# Encrypts stored credentials at rest. production REFUSES the example key.
# Generate: openssl rand -hex 32
KEY_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# CopilotKit Intelligence -- durable threads and memory. A license token is a
# required env var; the app will not run without it.
COPILOTKIT_API_KEY=
COPILOTKIT_LICENSE_TOKEN=
DEPLOYMENT_ID=pod-autopilot

# ---------------------------------------------------------------------------
# MODEL. No model ships in the box -- you supply the key.
# ---------------------------------------------------------------------------
BOT_PROVIDER=anthropic          # openai | anthropic | google
ANTHROPIC_API_KEY=
# BOT_MODEL unset -> provider default (claude-sonnet-4-5 / gpt-5.5 / gemini-2.5-flash)
BOT_MODEL=

# Image generation is called directly by the design engine, not by the bot.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# ---------------------------------------------------------------------------
# PER-BOT COMPUTERS. Without the supervisor all bots SHARE one browser, which
# means the TrendScout's Etsy session and the CatalogBot's Square session are
# the same profile. For a pipeline that logs into a payment account, isolate.
# ---------------------------------------------------------------------------
COMPUTER_SUPERVISOR_URL=http://supervisor:4300
COMPUTER_TOKEN=REPLACE_WITH_openssl_rand_hex_32
SUPERVISOR_TOKEN=REPLACE_WITH_openssl_rand_hex_32
AGENT_TOOL_TOKEN=REPLACE_WITH_openssl_rand_hex_32
WORKER_SHARED_SECRET=REPLACE_WITH_openssl_rand_hex_32
# gVisor sandboxing where the host supports it. Worth it: these bots browse
# third-party sites and execute shell commands.
COMPUTER_RUNTIME=runsc
COMPUTER_SANDBOX=on
# Let bots reach the pipeline services on this host (webhook receiver, DB).
AGENT_COMPUTER_ALLOW_PRIVATE_HOSTS=true

# The policy from openbot/policy.json, inlined or mounted.
# Malformed JSON stops server startup -- which is the desired behavior.
AGENT_COMPUTER_POLICY_FILE=./openbot/policy.json

TENANT_PACKAGE_DIR=./openbot/tenant

# ---------------------------------------------------------------------------
# POD PIPELINE
# ---------------------------------------------------------------------------
# Start in dry-run. Every write logs its payload instead of calling out.
# Watch ~20 designs flow end to end before you flip this off.
DRY_RUN=1
SQUARE_SANDBOX=1

PRINTFUL_API_TOKEN=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
DATABASE_URL=postgresql://pod:pod@localhost:5433/pod

# Public URL where design PNGs are hosted. Printful fetches print files BY URL.
# Cloudflare R2 public bucket is the cheap answer (~$0 for this volume).
ASSET_BASE_URL=https://assets.yourstore.com
ASSET_DIR=/workspace/assets
PUBLIC_WEBHOOK_URL=https://yourstore.com/hooks/square
PRINTFUL_HOOK_SECRET=REPLACE_WITH_openssl_rand_hex_16

# Demand sources
APIFY_TOKEN=            # USPTO TESS actor, ~$5 / 1000 checks
ETSY_API_KEY=           # Etsy Open API v3 (requires approval)
SERPAPI_KEY=            # optional, more reliable than scraping Trends

# ---------------------------------------------------------------------------
# GUARDRAILS. These are the numbers the Sentinel enforces. Set them TIGHT for
# the first month. You can loosen them once you have data; you cannot recover
# money already spent.
# ---------------------------------------------------------------------------
CAP_WEEKLY_FULFILLMENT=250.00
CAP_WEEKLY_ADS=70.00
CAP_DAILY_ADS=10.00
CAP_NEW_LISTINGS_DAY=6
CAP_CONCURRENT_TESTS=10
CAP_IP_STRIKES=1
CAP_REFUND_RATE=0.08
MIN_TEST_DAYS=5
MIN_TEST_IMPRESSIONS=800

# Square Online plan determines your fee. Free = 3.3% + $0.30 online.
SQUARE_FEE_PCT=0.033
SQUARE_FEE_FIXED=0.30
SHIPPING_AVG=4.50
TARGET_MARGIN=0.30
MIN_PROFIT=8.00

# Fonts must be commercially licensed. Drop OFL faces (Anton, Bebas Neue,
# Alfa Slab One) in this directory.
FONT_DIR=/workspace/fonts

# Audit retention. Keep forever unless disk is a problem -- the audit trail is
# your defense if a rights holder ever asks how a design got published.
AUDIT_RETENTION_DAYS=

# ===========================================================================
# pod-autopilot -- ZERO-CASH deployment (.env.zero.example)
# Everything below is a subscription you already pay for or a permanent free tier.
# In GitHub Actions these live in Settings -> Secrets and variables, not a file.
# ===========================================================================

# ---- mode ---------------------------------------------------------------
DRY_RUN=1                     # rehearse first. The ONLY switch between fake and real.
TRAFFIC_MODE=organic          # no ads => tests judged on clicks + orders over time
ART_PROVIDER=svg              # svg (default) | none (type-only) | cloudflare (FLUX free tier)
LLM_PROVIDER=claude_code,gemini,github_models   # tried in order, falls through on limits
CAP_WEEKLY_ADS=0
CAP_DAILY_ADS=0
CAP_NEW_LISTINGS_DAY=4        # Printful mockup limit is 2/min on new stores; stay small
CAP_CONCURRENT_TESTS=12
ORGANIC_MIN_DAYS=14
ORGANIC_MIN_CLICKS=40
ORGANIC_MAX_DAYS=35
ORGANIC_MIN_CVR=0.01

# ---- brains (no API bills) --------------------------------------------
# Claude Pro: run `claude setup-token` once on your laptop, paste the token.
CLAUDE_CODE_OAUTH_TOKEN=
# Google AI Studio free tier (aistudio.google.com -> Get API key). No card.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GitHub Models: fine-grained PAT with "Models: read". Free. Low daily cap.
GH_MODELS_TOKEN=
GH_MODEL=openai/gpt-4.1-mini
# DO NOT SET: OPENAI_API_KEY / ANTHROPIC_API_KEY (zero_cash_check refuses them)

# ---- optional raster art (Cloudflare Workers AI free: 10k neurons/day) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
# UPSCALER_CMD="realesrgan-ncnn-vulkan -i {in} -o {out} -s 4 -n realesrgan-x4plus"

# ---- commerce (accounts you already have) ------------------------------
PRINTFUL_API_TOKEN=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_STORE_URL=https://YOURSTORE.square.site
STORE_NAME=Your Store

# ---- storage: Neon free Postgres (neon.tech, no card) -------------------
DATABASE_URL=postgresql://user:pass@ep-xxx.us-west-2.aws.neon.tech/pod?sslmode=require

# ---- print-file hosting: public GitHub repo release assets ---------------
ASSETS_GH_REPO=YOURNAME/pod-assets
ASSETS_GH_TOKEN=
ASSET_TTL_HOURS=48

# ---- IP gate: Apify free plan ($5 credits/mo ~ 1,000 USPTO checks) ------
APIFY_TOKEN=

# ---- $0 traffic ----------------------------------------------------------
CLICK_WORKER_URL=https://pod-go.YOURNAME.workers.dev
CLICK_STATS_TOKEN=
FEED_SITE_URL=https://YOURNAME.github.io/pod-autopilot

# ---- misc ----------------------------------------------------------------
FONT_DIR=./fonts
POD_NICHES=nursing,teacher,dogs,plants,fishing,pickleball
